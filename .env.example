# Coffee ledger configuration. Copy to .env and edit; never commit .env.
# Values with spaces need quotes. In production the app refuses to start if SECRET_KEY or
# ACCESS_CODE are missing, too short or still placeholders, or if PUBLIC_BASE_URL is not https.

# --- Deployment -------------------------------------------------------------------------------
# "production" enforces https, secure cookies, HSTS and disables the API docs.
# Use "development" only for a local run over http.
ENVIRONMENT=production
# Public address users reach (also the content of the QR codes). Must be https:// in production.
PUBLIC_BASE_URL=https://coffee.example.org
# Docker Compose overrides this with the volume path (sqlite:////data/coffee.db).
# For a run without Docker: sqlite:///./data/coffee.db
DATABASE_URL=sqlite:////data/coffee.db
# Comma-separated IPs/CIDRs of the reverse proxy whose X-Forwarded-* headers are trusted.
# Empty = trust none (client IP = connecting peer). Example for a proxy on the Docker host: 172.16.0.0/12
TRUSTED_PROXY_IPS=
# stdout log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Secrets (generate real values; see README) ------------------------------------------------
# Random value, at least 32 characters:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-generate-a-random-value-of-48-characters
# Shared department access code (>= 8 characters) gating profile creation/selection.
# Rotate by editing this line and restarting the app.
ACCESS_CODE=change-me-department-access-code

# --- First administrator (optional) -----------------------------------------------------------
# Created automatically at start while NO administrator exists, ignored afterwards.
# Password: at least 12 characters. Remove both lines after the first start.
# Alternative: docker compose run --rm app python -m app.cli create-admin --username NAME --role global
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Sessions and admin login -----------------------------------------------------------------
# Lifetime of a normal user's browser session in days.
SESSION_LIFETIME_DAYS=180
# Lifetime of an admin session in hours.
ADMIN_SESSION_HOURS=12

# --- Display and locale -----------------------------------------------------------------------
LOCAL_TIMEZONE=Europe/Berlin
APP_TITLE="Coffee Ledger"
# Shown on the /privacy page (e.g. a name and an email address of the operator).
OPERATOR_CONTACT=
# Retention statement on the /privacy page (empty = built-in default text).
# RETENTION_TEXT="Ledger entries are kept as long as the coffee ledger is operated."
# What a chair is called in the UI, e.g. "Chair" or "Coffee group".
CHAIR_LABEL=Chair
# ISO code, optionally followed by ":" and the display symbol, e.g. EUR or EUR:€
CURRENCY=EUR:€

# --- Scan behaviour ---------------------------------------------------------------------------
# How long a user may undo their latest coffee (seconds).
UNDO_WINDOW_SECONDS=300
# Safety cap against accidental scan loops.
MAX_COFFEES_PER_SESSION_PER_HOUR=30

# --- CSV export (defaults suit German Excel) --------------------------------------------------
CSV_DELIMITER=";"
CSV_DECIMAL_SEPARATOR=","

# --- Docker Compose only ----------------------------------------------------------------------
# Host directory mounted at /backups for scripts/backup.sh (default ./backups).
# BACKUP_HOST_DIR=./backups

# --- v2: mail and accounts (mail login is NOT an env var; store it with `python -m app.cli setup-mail`) ---
# Mail backend: smtp (required in production), console, memory or file (development/tests only).
# Leave unset to get smtp in production and console in development.
# MAIL_BACKEND=smtp
# SMTP_HOST=postout.lrz.de
# SMTP_PORT=587
# starttls (port 587) or ssl (port 465)
# SMTP_SECURITY=starttls
# Sender address shown on verification and reset mails. Required in production.
MAIL_FROM=
# Directory for MAIL_BACKEND=file.
# MAIL_FILE_DIR=
# Directory holding the encrypted mail login (mount a volume here).
# SECRETS_DIR=/secrets
# Cap on outgoing mails per hour.
# MAIL_MAX_PER_HOUR=30
# Comma-separated email domains allowed for members; *.tum.de matches subdomains only.
# ALLOWED_EMAIL_DOMAINS=tum.de,mytum.de,*.tum.de
# VERIFICATION_TTL_HOURS=24
# GUEST_APPROVAL_TTL_DAYS=7
# RESET_TTL_MINUTES=60
# PASSWORD_MIN_LENGTH=10
# How long a step-up (re-authentication) stays valid for sensitive admin actions.
# STEPUP_WINDOW_SECONDS=300
# Require a TOTP step-up to set balances (defaults to true in production).
# BALANCE_TOTP_REQUIRED=true
# Argon2id password hashing cost; keep the defaults in production (tests lower them).
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=4
# ACCESS_CODE above is optional from v2 on (the v1 gate code goes away in a later task).
