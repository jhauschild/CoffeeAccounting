# Coffee ledger configuration (v2). Copy to .env, edit, `chmod 600 .env`; never commit .env.
# Values with spaces need quotes. In production the app refuses to start if SECRET_KEY or MAIL_FROM are
# missing, too short or placeholders, if PUBLIC_BASE_URL is not https, or if the mail settings are
# inconsistent. Everything below is optional unless marked REQUIRED.

# --- Deployment -------------------------------------------------------------------------------
# "production" enforces https, secure cookies, HSTS, the smtp mail backend and hides the API docs.
# Use "development" only for a local run over http. (docker-compose.yml forces production.)
ENVIRONMENT=production
# REQUIRED. Public address users reach (also the content of the QR codes and of the mailed links).
# Must be https:// in production.
PUBLIC_BASE_URL=https://coffee.example.org
# Docker Compose overrides this with the volume path (sqlite:////data/coffee.db).
# For a run without Docker: sqlite:///./data/coffee.db
DATABASE_URL=sqlite:////data/coffee.db
# Comma-separated IPs/CIDRs of the reverse proxy whose X-Forwarded-* headers are trusted.
# Empty = trust none (client IP = connecting peer). SET THIS whenever a reverse proxy sits in front (the
# documented Docker setup does): with it empty the app sees the proxy's address for EVERY visitor, so all
# visitors share ONE rate-limit bucket and 20 failed sign-ins lock out everybody for 15 minutes. The app logs a
# warning at start (and once per hour when a request carries X-Forwarded-For from an untrusted peer).
# Proxy on the Docker host, port published on 127.0.0.1: the container sees the compose bridge gateway; use the
# subnet of the compose network, found with
#   docker network inspect "$(basename "$PWD")_default" --format '{{ (index .IPAM.Config 0).Subnet }}'
# e.g. TRUSTED_PROXY_IPS=172.18.0.0/16  (or 172.16.0.0/12 for any Docker bridge). See README step 4.
# Never put a range there that untrusted hosts can connect from: they could then choose their own address.
TRUSTED_PROXY_IPS=
# stdout log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Secrets ----------------------------------------------------------------------------------
# REQUIRED. Random value, at least 32 characters:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# It signs cookies and tokens AND derives the key that encrypts the stored mail login. If you change it,
# every session and link becomes invalid and the mail login becomes unreadable: run `setup-mail` again.
SECRET_KEY=change-me-generate-a-random-value-of-48-characters

# --- Mail (v2: registration, guest approval, password reset) ----------------------------------
# THE MAIL LOGIN IS NEVER ENTERED HERE. There is no SMTP_USER or SMTP_PASSWORD setting. The username and
# password of the sending mailbox are asked for with hidden prompts by
#   docker compose run --rm -it app python -m app.cli setup-mail
# and stored encrypted in the `secrets` volume (SECRETS_DIR). They are not in this file, in
# docker-compose.yml, in the image, in the database or in any backup.
#
# Mail backend: smtp (required in production; docker-compose.yml sets it), or console / memory / file
# for development and tests only. Leave unset: smtp in production, console in development.
# MAIL_BACKEND=smtp
SMTP_HOST=postout.lrz.de
# 587 with SMTP_SECURITY=starttls, or 465 with SMTP_SECURITY=ssl. Certificates are always verified.
SMTP_PORT=587
SMTP_SECURITY=starttls
# REQUIRED in production. Sender of every mail; use the address that belongs to the mailbox whose login
# you give to setup-mail (LRZ may reject other From addresses). Example: "Coffee Ledger <coffee@example.org>"
MAIL_FROM=
# Directory for MAIL_BACKEND=file (development and browser tests only).
# MAIL_FILE_DIR=
# Directory holding the encrypted mail login (docker-compose.yml mounts the `secrets` volume here).
# SECRETS_DIR=/secrets
# Cap on outgoing mails per hour (also protects the mailbox from being flagged).
MAIL_MAX_PER_HOUR=30

# --- Accounts ---------------------------------------------------------------------------------
# Comma-separated email domains allowed for members; *.tum.de matches subdomains only.
ALLOWED_EMAIL_DOMAINS=tum.de,mytum.de,*.tum.de
# Validity of the member email confirmation link.
VERIFICATION_TTL_HOURS=24
# How long a guest request waits for its sponsor.
GUEST_APPROVAL_TTL_DAYS=7
# Validity of a password reset link.
RESET_TTL_MINUTES=60
# Minimum password length for users (maximum is 128). Administrators created on the command line need 12.
PASSWORD_MIN_LENGTH=10
# Lifetime of a normal user's browser session in days.
SESSION_LIFETIME_DAYS=180
# Days after anonymizing deactivation during which the original name/username/email can be restored
# (admin button or sign-in with the old username and password). After that, purge-expired drops the stash.
IDENTITY_RESTORE_DAYS=90
# Auto-deactivate (anonymize) active accounts with no login or coffee activity for this many days.
# Run: python -m app.cli deactivate-inactive
INACTIVE_ACCOUNT_DAYS=180

# --- Administrators ---------------------------------------------------------------------------
# Preferred first start: `python -m app.cli setup` (guided, hidden prompts). Alternative: these two
# variables create the head admin at start while NO administrator exists; remove both lines afterwards.
# Password: at least 12 characters.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
# Lifetime of an admin session in hours.
ADMIN_SESSION_HOURS=12
# How long a step-up (TOTP re-authentication) stays valid for balance-changing actions.
STEPUP_WINDOW_SECONDS=300
# Require TOTP: admins enrol once, balance changes need a step-up. Defaults to true in production,
# false in development. Leave it unset in production: the app refuses to start with
# ENVIRONMENT=production and BALANCE_TOTP_REQUIRED=false.
# BALANCE_TOTP_REQUIRED=true
# Argon2id password hashing cost; keep the defaults in production (tests lower them).
# ARGON2_TIME_COST=3
# ARGON2_MEMORY_COST_KIB=65536
# ARGON2_PARALLELISM=4

# --- Display and locale -----------------------------------------------------------------------
LOCAL_TIMEZONE=Europe/Berlin
APP_TITLE="Coffee Ledger"
# Shown on the /privacy page (e.g. a name and an email address of the operator).
OPERATOR_CONTACT=
# Retention statement on the /privacy page (empty = built-in default text).
# RETENTION_TEXT="Ledger entries are kept as long as the coffee ledger is operated."
# What a chair is called in the UI, e.g. "Chair" or "Coffee group".
CHAIR_LABEL=Chair
# ISO code, optionally followed by ":" and the display symbol, e.g. EUR or EUR:€
CURRENCY=EUR:€

# --- Scan behaviour ---------------------------------------------------------------------------
# How long a user may undo their latest coffee (seconds).
UNDO_WINDOW_SECONDS=300
# Safety cap against accidental scan loops.
MAX_COFFEES_PER_SESSION_PER_HOUR=30

# --- CSV export (defaults suit German Excel) --------------------------------------------------
CSV_DELIMITER=";"
CSV_DECIMAL_SEPARATOR=","

# --- Docker Compose only ----------------------------------------------------------------------
# Host directory mounted at /backups for scripts/backup.sh (default ./backups). Backups contain the
# SQLite database only, never the secrets volume.
# BACKUP_HOST_DIR=./backups
